# ==============================================================================
# The Almirah — Environment Configuration
# All operations run 100% offline. Zero cloud API keys required.
# ==============================================================================

# Backend API URL (for Live Mode)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Force Demo Mode flag (true = uses precomputed synthetic documents, ideal for Vercel/demo links)
NEXT_PUBLIC_DEMO_MODE=false

# Ollama local inference endpoint
OLLAMA_BASE_URL=http://localhost:11434

# Configurable Model Tags (swap depending on available hardware VRAM/RAM)
# Recommended text model: qwen2.5:7b-instruct (or qwen3, qwen2.5:3b, qwen2.5:14b)
TEXT_MODEL_NAME=qwen2.5:7b

# Recommended vision model: qwen2.5-vl:7b (or qwen2.5-vl:3b)
VISION_MODEL_NAME=qwen2.5-vl:7b

# Recommended embeddings model: bge-m3
EMBEDDING_MODEL_NAME=bge-m3

# Fast CPU OCR Fallback enabled when vision model is unavailable or slow
ENABLE_OCR_FALLBACK=true

# Storage directory for checksummed uploaded files
STORAGE_DIR=./data/documents

# SQLite Database path
DATABASE_PATH=./data/almirah.db
